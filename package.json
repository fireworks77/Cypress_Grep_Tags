{
  "name": "cypress_grep_tags",
  "version": "1.0.0",
  "description": "Cypress Grep & Tags Demo",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "cypress:open": "cypress open",
    "cypress:smoke": "cypress run --env grepTags=@smoke",
    "cypress:regression": "cypress run --env grepTags=@regression",
    "cypress:specs": "cypress run --env grepTags=@regression --spec $1"
  },
  "author": "chong.xiang",
  "license": "MIT",
  "devDependencies": {
    "@cypress/grep": "^3.1.3",
    "cypress": "^12.4.0",
    "pg-promise": "^11.9.1"
  }
}
